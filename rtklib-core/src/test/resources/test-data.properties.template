# Test Data Configuration (LOCAL - not committed to git)
# Copy this file to test-data.properties and fill in your paths.
# The file test-data.properties is in .gitignore and will NOT be committed.

# === Public Test Data ===

# test-data/ directory (auto-detected if not set)
# Contains: tle/, rinex/, rtcm/, product/, reference/, config/
# test-data.dir=test-data

# === Core Data Paths ===

# RTCM data directory (defaults to test-data/rtcm)
# rtcm.base.dir=test-data/rtcm

# Product directory (SP3, CLK, ERP, DCB, GPT3, VMF3, FCB/OSB, BLQ)
# product.dir=test-data/product

# Result output directory
# result.dir=

# === Station / Device IDs (fill in your own) ===

# station.id=YOUR_STATION_ID
# station.date=YYYY-MM-DD

# === Direct File/Directory Paths ===
# Supports both file and directory paths:
#   File:   rover.file=D:\rtcm3\ROVER_ID\2026-05-20\08.rtcm3
#   Dir:    rover.file=D:\rtcm3\ROVER_ID\2026-05-20
# When a directory is specified, all .rtcm3 files under it are recursively
# collected and sorted by path (lexicographic string order, NOT time order).
# For 设备/日期/小时.rtcm3 structure, hour filenames MUST be zero-padded
# (08.rtcm3, not 8.rtcm3), otherwise 10.rtcm3 sorts before 8.rtcm3
# (string order: 10 < 8 < 9).
# If your data does not follow this convention, write your own test.
# Use directory path depth to control data scope:
#   设备/日期/小时.rtcm3  → single hour file
#   设备/日期/             → all hours of that day
#   设备/                  → all dates and hours (use with caution)
#
# Directory pairing rule:
#   When both rover.file and base.file are directories, the program scans
#   base directory for .rtcm3 files, computes each file's relative path
#   (e.g. 2026-05-20/8.rtcm3), and looks for the same relative path
#   under the rover directory. Matched pairs are returned; unmatched
#   base files are skipped.
#   Requirement: base and rover directories must have identical relative
#   file paths (same subdirectory structure and file names).

# rover.file=test-data/rtcm/ROVER_ID/YYYY-MM-DD/08.rtcm3
# base.file=test-data/rtcm/BASE_ID/YYYY-MM-DD/08.rtcm3

# === RINEX Data (for VerifyPositioningTest, ForwardBackwardFilterTest) ===

# RINEX data directory containing rover/ and base/ subdirectories
# rinex.data.dir=test-data/rinex

# RTK data directory for ForwardBackwardFilterTest (rover.obs, base.obs, rover.nav)
# rtk.data.dir=test-data/rinex

# === GREAT-PVT sample data (public, auto-detected) ===

# greatpvt.ppp.dir=D:/code/GREAT-PVT/sample_data/PPPFLT_2023305/PPPFLT_2023305
# greatpvt.rtk.dir=D:/code/GREAT-PVT/sample_data/RTKFLT_2020351/RTKFLT_2020351

# === C Version Comparison (optional) ===

# Path to C RTKLIB rnx2rtkp executable
# rtklib.rnx2rtkp=RTKLIB_EX_2.5.0/rnx2rtkp.exe

# Path to C RTKLIB directory (for RtkIonoptTest C comparison)
# rtklib.c.dir=RTKLIB_EX_2.5.0

# SPP Compare Test data directory (contains 1.obs, 1.nav, spp_bds.pos)
# sppcompare.data.dir=RTKLIB_EX_2.5.0

# C version SPP result file (for SppProcessorTest comparison)
# spp.c.result.file=test-data/reference/spp_c_full.pos

# C version RINEX files (for RinexConversionTest comparison)
# rinex.c.obs=test-data/rinex/full.obs
# rinex.c.nav=test-data/rinex/full.nav

# === SBAS Test Data (optional) ===

# Path to .sbs SBAS message file
# sbs.file=test-data/test.sbs

# === Ionopt Test (optional) ===

# ionopt.date=2026-05-20
# ionopt.start.hour=8
# ionopt.end.hour=10