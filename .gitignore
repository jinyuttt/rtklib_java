# Local credentials config (contains passwords, NEVER commit)
**/credentials.properties
credentials.properties

# Test data: keep README.md, .meta, .conf, .txt, small sample files
# Only ignore large binary data files (>2MB) in specific subdirs
test-data/rinex/*.obs
test-data/rinex/*.nav
test-data/product/*.sp3
test-data/product/*.clk
test-data/product/*.erp
test-data/product/*.dcb
test-data/product/*.bia
test-data/product/*.bsx
test-data/product/*.blq
test-data/product/*.dat
test-data/reference/*.pos

# Large test data directories (not for git, use download-test-data.ps1)
test-data/ppc/
test-data/urbannav/

# Debug log config (local only)
logback-debug.xml