# RTKLIB 凭据配置文件
# 此文件包含敏感信息，已在.gitignore中，不会提交到Git
# 
# 使用方法：
# 1. 复制此文件为 credentials.properties
# 2. 填写下面的凭据
# 3. 将此文件放在以下位置之一：
#    - ~/.rtklib/credentials.properties (推荐)
#    - 当前工作目录
#    - 或通过 -Drtklib.credentials=/path/to/credentials.properties 指定
#
# 安全提示：
# - 建议设置文件权限：chmod 600 credentials.properties (Linux/Mac)
# - 不要在公共场所配置此文件
# - 不要将此文件提交到版本控制系统

# CDDIS (NASA Earthdata) 凭据
# 用于下载精密星历、钟差、OSB等产品
# 注册地址：https://urs.earthdata.nasa.gov/
cddis.username=your_username_here
cddis.password=your_password_here
